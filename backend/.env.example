# Copy to .env and fill in. The app runs without a key — every AI path has a
# deterministic fallback and all LLM output is cached to data/llm_cache/.

# Any OpenAI-compatible endpoint. Examples:
#   AvalAI  https://api.avalai.ir/v1
#   Metis   https://api.metisai.ir/openai/v1
#   Liara   https://ai.liara.ir/api/v1/<id>
#   Ollama  http://localhost:11434/v1
LLM_BASE_URL=https://api.avalai.ir/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30

# Set to false to force cache-only mode. Recommended while recording the demo:
# the app then never touches the network.
LLM_LIVE=true
